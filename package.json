{
  "name": "@warmbros/warmbros-components",
  "version": "0.1.1",
  "description": "React component library by WarmBros — pricing, footer, scroll-reveal frame, and brand primitives. CSS Modules, themeable via CSS variables, zero Tailwind dependency.",
  "type": "module",
  "author": "Norayr Avetisyan <norayr@warmbros.dev>",
  "license": "MIT",
  "homepage": "https://github.com/Noro97/warmbros-components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noro97/warmbros-components.git"
  },
  "bugs": {
    "url": "https://github.com/Noro97/warmbros-components/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./SplineScene": {
      "import": {
        "types": "./dist/SplineScene.d.ts",
        "default": "./dist/SplineScene.mjs"
      },
      "require": {
        "types": "./dist/SplineScene.d.ts",
        "default": "./dist/SplineScene.cjs"
      }
    },
    "./Receipt3D": {
      "import": {
        "types": "./dist/Receipt3D.d.ts",
        "default": "./dist/Receipt3D.mjs"
      },
      "require": {
        "types": "./dist/Receipt3D.d.ts",
        "default": "./dist/Receipt3D.cjs"
      }
    },
    "./styles.css": "./dist/components.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsc --noEmit && vite build",
    "build:storybook": "storybook build -o storybook-static",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@splinetool/react-spline": "^4.0.0",
    "@splinetool/runtime": "^1.0.0",
    "framer-motion": "^11.0.0 || ^12.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@splinetool/react-spline": {
      "optional": true
    },
    "@splinetool/runtime": {
      "optional": true
    }
  },
  "devDependencies": {
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.81",
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/react-vite": "^10.2.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "framer-motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "^10.2.19",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "keywords": [
    "react",
    "react-19",
    "components",
    "component-library",
    "ui",
    "pricing",
    "footer",
    "scroll-animation",
    "framer-motion",
    "css-modules",
    "warmbros"
  ]
}
